ENV="dev"

LOG_LEVEL="debug"
DB_LOG_LEVEL="silent"

# Port nginx binds on the host
PORT="8080"

# Public base URL of the site (used in email links and feed metadata)
HOST="http://localhost:8080"

# Postgres
PG_DATA="/var/lib/postgresql/18/docker"

POSTGRES_HOST="bruttice-db"
POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
POSTGRES_PORT=5432
TZ=UTC
PGTZ=UTC

# Outbound email goes through Resend (https://resend.com), from site.contact-email in
# config.yaml, which has to be on a domain you verified there. Leave the key blank to turn
# email and the contact form off.
RESEND_API_KEY=""

# IP geolocation for the cookie-consent analytics (ipgeolocation.io)
# Leave blank to skip geo lookup
IP_GEOLOCATION_IO_API_KEY=""

# RSS / Atom / JSON feed metadata
FEED_TITLE="My Event Calendar"
FEED_DESCRIPTION="Upcoming local events"
FEED_AUTHOR="admin@example.com"
